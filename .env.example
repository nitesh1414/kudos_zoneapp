# ZoneApp Configuration
# Copy this file to backend/app/.env and customize.

ZONEAPP_API_KEY=change-to-a-long-random-key
ZONEAPP_ENCRYPTION_KEY=change-to-a-fernet-key
ZONEAPP_SECURE_COOKIES=true
ZONEAPP_UPLOADS=./data/uploads
ZONEAPP_SYMBOL=NSE:NIFTY50-INDEX

# Fyers Default Broker Credentials
# These are pre-filled in the admin UI when adding a Fyers broker connection.
FYERS_CLIENT_ID=your-fyers-client-id
FYERS_SECRET_KEY=your-fyers-secret-key
FYERS_USER_ID=your-fyers-user-id
FYERS_PIN=1234
FYERS_TOTP_KEY=your-totp-key
FYERS_REDIRECT_URI=https://fyers.in/

# PostgreSQL or TimescaleDB (required)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/zoneapp

# First admin is created on initial startup. Use a strong password.
ZONEAPP_ADMIN_USERNAME=admin
ZONEAPP_ADMIN_PASSWORD=change-this-to-a-strong-password