# PostgreSQL or TimescaleDB (required)
DATABASE_URL=postgresql://zoneapp:change-db-password@127.0.0.1:5432/zoneapp

# First admin is created on initial startup. Use a strong password.
ZONEAPP_ADMIN_USERNAME=admin
ZONEAPP_ADMIN_PASSWORD=change-this-admin-password

# Used only by cron/job automation, not browser login.
ZONEAPP_API_KEY=change-to-a-long-random-value
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ZONEAPP_ENCRYPTION_KEY=replace-with-a-fernet-key
ZONEAPP_SECURE_COOKIES=true
ZONEAPP_UPLOADS=/opt/zoneapp/data/uploads
