# ZoneApp configuration — copy this file to backend/.env and edit it.
#
#   cp backend/.env.example backend/.env
#
# Every process (API, market-close worker, seeder, CLI scripts) reads this one
# file, so the same credentials are used everywhere. Real environment
# variables take precedence over anything set here.

# ----------------------------------------------------------------- database
# PostgreSQL 16+, with the TimescaleDB extension when it is available.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://zoneapp:change-db-password@127.0.0.1:5432/zoneapp

# ------------------------------------------------------------------ accounts
# The first administrator is created on initial startup. Use a strong password.
ZONEAPP_ADMIN_USERNAME=admin
ZONEAPP_ADMIN_PASSWORD=change-this-admin-password

# ------------------------------------------------------------------- secrets
# Used by the cron/market-close job only, never for browser login.
ZONEAPP_API_KEY=change-to-a-long-random-value

# Encrypts stored broker credentials. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# If it is left unset the application generates a key and keeps it in the
# database, which works but ties the credentials to that database.
# Never change this value on a live installation: existing broker credentials
# would have to be entered again.
ZONEAPP_ENCRYPTION_KEY=replace-with-a-fernet-key

# Set to false only when serving over plain HTTP (local development).
ZONEAPP_SECURE_COOKIES=true

# ------------------------------------------------------------------- market
# Fallback symbol used before any symbol is added to the watchlist.
ZONEAPP_SYMBOL=NSE:NIFTY50-INDEX

# ------------------------------------------------------- broker (Fyers) defaults
# Pre-filled in the administrator UI when adding a Fyers connection. The daily
# access token is entered in the UI and stored encrypted — never put it here.
FYERS_CLIENT_ID=your-fyers-client-id
FYERS_SECRET_KEY=your-fyers-secret-key
FYERS_REDIRECT_URI=https://fyers.in/
